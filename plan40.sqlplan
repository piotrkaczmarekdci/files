  <BatchSequence>
    <Batch>
      <Statements>
        <StmtSimple StatementCompId="1" StatementEstRows="326280" StatementId="1" StatementOptmLevel="FULL" CardinalityEstimationModelVersion="150" StatementSubTreeCost="914.767" StatementText="select kk.IDKK, kk.ID_KONTRAKT,&#xD;&#xA;(select max(dt.BLOKDATA) from SPOTLISTA s, bloklista bl, blokprogram bp, dniotwarte dt where s.id_kontrakt=k.idkontrakt and s.ID_BLOK=bl.IDBLOK and bp.IDBLOKPROGRAM=bl.ID_BLOKPROGRAM and dt.IDDNIOTWARTE=bp.ID_DNIOTWARTE) as lastday,&#xD;&#xA;(select count(*) from multi_orders mo where mo.ID_MULTIKONTRAKT=k.idkontrakt) as IsPodzlecenie,&#xD;&#xA;(select count(*) from multi_orders mo where mo.ID_MASTERKONTRAKT=k.idkontrakt) as IsMasterZlecenie,&#xD;&#xA;(select top 1 k1.numerkontrakt from multi_orders mo, kontraktlista k1 where k1.idkontrakt=mo.id_masterkontrakt and mo.ID_MULTIKONTRAKT=k.idkontrakt) as MasterNumer,&#xD;&#xA;(select ISPMP from KONTRAKTLISTA_SYSTEM_EXT  where NUMERKONTRAKT = k.numerkontrakt) as ISPMP,&#xD;&#xA;(select count(*) from REZ_LU_KONTRAKT luk where luk.id_kontraktlista=k.idkontrakt) as iloscumow1,&#xD;&#xA;(select count(*) from  multi_orders mo, kontraktlista kmaster, REZ_LU_KONTRAKT luk1  where k.idkontrakt=mo.id_multikontrakt and mo.id_masterkontrakt=kmaster.idkontrakt and kmaster.idkontrakt=luk1.id_kontraktlista) as iloscumow2,&#xD;&#xA;(select COUNT(*) from fakturazbiorcza_kk fzkk, fakturazbiorcza fz where fzkk.id_kk=kk.idkk and fzkk.id_fz=fz.idfz) as IsFZ,&#xD;&#xA;(select top 1 fz.numerfaktury from fakturazbiorcza_kk fzkk, fakturazbiorcza fz where fzkk.id_kk=kk.idkk and fzkk.id_fz=fz.idfz) as numerFZ,&#xD;&#xA;(select top 1 fz.idFZ from fakturazbiorcza_kk fzkk, fakturazbiorcza fz where fzkk.id_kk=kk.idkk and fzkk.id_fz=fz.idfz) as IdFZ,&#xD;&#xA;(select TOP 1 sz.NUMERZAMOWIENIA from sponsoring_zamowienie sz, sponsoring_zamowienie_channels szc where k.IDKONTRAKT=szc.ID_SUBORDER and szc.ID_SZ=sz.IDSZ) as numerZL,&#xD;&#xA;(SELECT mop.IS_WO_DIGITAL FROM MULTI_ORDERS_PARAMS mop WHERE mop.ID_KONTRAKT=k.IDKONTRAKT) AS IS_WO_DIGITAL&#xD;&#xA;from kontrakt_korekty kk, kontraktlista k, blokperiod bd&#xD;&#xA;where kk.id_kontrakt=k.idkontrakt and k.id_okres=bd.idblokperiod and bd.okresblokperiod in (2026*12+7)" StatementType="SELECT" QueryHash="0x675C3F1D64540371" QueryPlanHash="0x0947AE7B0428CD0D" RetrievedFromCache="true" StatementSqlHandle="0x0900825E9774B9A977FFA9B49A05B3D1E63C0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="17" ParentObjectId="0" StatementParameterizationType="0" SecurityPolicyApplied="false" BatchModeOnRowStoreUsed="true">
