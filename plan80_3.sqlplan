    <Batch>
      <Statements>
        <StmtSimple StatementCompId="1" StatementEstRows="102802" StatementId="1" StatementOptmLevel="FULL" CardinalityEstimationModelVersion="150" StatementSubTreeCost="68.8443" StatementText="SELECT&#xA;    kk.IDKK,&#xA;    kk.ID_KONTRAKT,&#xA;&#xA;    spot_agg.BLOKDATA_MAX&#xA;&#xA;&#xA;FROM kontrakt_korekty kk&#xA;JOIN kontraktlista k   ON kk.id_kontrakt = k.idkontrakt&#xA;JOIN blokperiod bd     ON k.id_okres = bd.idblokperiod&#xA;                      AND bd.okresblokperiod = (2026*12+7)&#xA;&#xA;-- MAX(BLOKDATA) zamiast subquery z 4 tabelami&#xA;LEFT JOIN (&#xD;&#xA;    SELECT s.id_kontrakt, MAX(dt.BLOKDATA) AS BLOKDATA_MAX&#xD;&#xA;    FROM SPOTLISTA s&#xD;&#xA;    JOIN BLOKLISTA   bl ON s.ID_BLOK        = bl.IDBLOK&#xD;&#xA;    JOIN BLOKPROGRAM bp ON bp.IDBLOKPROGRAM = bl.ID_BLOKPROGRAM&#xD;&#xA;    JOIN DNIOTWARTE  dt ON dt.IDDNIOTWARTE  = bp.ID_DNIOTWARTE&#xD;&#xA;    -- ogranicz tylko do kontraktów z okresu&#xD;&#xA;    JOIN kontraktlista k2  ON k2.idkontrakt = s.id_kontrakt&#xD;&#xA;    JOIN blokperiod bd2    ON k2.id_okres   = bd2.idblokperiod&#xD;&#xA;                          AND bd2.okresblokperiod = (2026*12+7)&#xD;&#xA;    GROUP BY s.id_kontrakt&#xD;&#xA;) spot_agg ON spot_agg.id_kontrakt = k.idkontrakt" StatementType="SELECT" QueryHash="0x4F34E6662A2D5F8F" QueryPlanHash="0xCFD17969BDA45140" RetrievedFromCache="true" StatementSqlHandle="0x09004B684552753FC50047C499F45133CEBC0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="17" ParentObjectId="0" StatementParameterizationType="0" SecurityPolicyApplied="false" BatchModeOnRowStoreUsed="true">
