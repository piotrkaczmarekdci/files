<?xml version="1.0" encoding="utf-16"?>
<ShowPlanXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" Version="1.539" Build="15.0.4395.2" xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan">
  <BatchSequence>
    <Batch>
      <Statements>
        <StmtSimple StatementCompId="1" StatementEstRows="655985" StatementId="1" StatementOptmLevel="FULL" CardinalityEstimationModelVersion="150" StatementSubTreeCost="196.846" StatementText="SELECT&#xA;    kk.IDKK,&#xA;    kk.ID_KONTRAKT,&#xA;&#xA;    -- Zamiast subquery: LEFT JOIN z agregacj¹ w CTE&#xA;    spot_agg.BLOKDATA_MAX,&#xA;&#xA;    ISNULL(mo_multi.cnt, 0)    AS IsPodzlecenie,&#xA;    ISNULL(mo_master.cnt, 0)   AS IsMasterZlecenie,&#xA;&#xA;    mo_master_num.numerkontrakt AS MasterNumer,&#xA;&#xA;    kse.ISPMP,&#xA;&#xA;    ISNULL(luk1.cnt, 0)        AS iloscumow1,&#xA;    ISNULL(luk2.cnt, 0)        AS iloscumow2,&#xA;&#xA;    ISNULL(fz_agg.cnt, 0)      AS IsFZ,&#xA;    fz_top.numerfaktury        AS numerFZ,&#xA;    fz_top.idFZ                AS IdFZ,&#xA;&#xA;    sz_top.NUMERZAMOWIENIA     AS numerZL,&#xA;&#xA;    mop.IS_WO_DIGITAL&#xA;&#xA;FROM kontrakt_korekty kk&#xA;JOIN kontraktlista k        ON kk.id_kontrakt = k.idkontrakt&#xA;JOIN blokperiod bd          ON k.id_okres = bd.idblokperiod&#xA;                           AND bd.okresblokperiod IN (2026*12+7)&#xA;&#xA;-- MAX(BLOKDATA) - zast¹pienie subquery z 4 tabelami&#xA;LEFT JOIN (&#xA;    SELECT s.id_kontrakt, MAX(dt.BLOKDATA) AS BLOKDATA_MAX&#xA;    FROM SPOTLISTA s&#xA;    JOIN BLOKLISTA bl       ON s.ID_BLOK = bl.IDBLOK&#xA;    JOIN BLOKPROGRAM bp     ON bp.IDBLOKPROGRAM = bl.ID_BLOKPROGRAM&#xA;    JOIN DNIOTWARTE dt      ON dt.IDDNIOTWARTE = bp.ID_DNIOTWARTE  -- zak³adana kolumna, dopasuj jeœli inna&#xA;    GROUP BY s.id_kontrakt&#xA;) spot_agg ON spot_agg.id_kontrakt = k.idkontrakt&#xA;&#xA;-- IsPodzlecenie&#xA;LEFT JOIN (&#xA;    SELECT ID_MULTIKONTRAKT, COUNT(*) AS cnt&#xA;    FROM multi_orders&#xA;    GROUP BY ID_MULTIKONTRAKT&#xA;) mo_multi ON mo_multi.ID_MULTIKONTRAKT = k.idkontrakt&#xA;&#xA;-- IsMasterZlecenie&#xA;LEFT JOIN (&#xA;    SELECT ID_MASTERKONTRAKT, COUNT(*) AS cnt&#xA;    FROM multi_orders&#xA;    GROUP BY ID_MASTERKONTRAKT&#xA;) mo_master ON mo_master.ID_MASTERKONTRAKT = k.idkontrakt&#xA;&#xA;-- MasterNumer (TOP 1 — u¿yj ROW_NUMBER zamiast subquery)&#xA;LEFT JOIN (&#xA;    SELECT mo.ID_MULTIKONTRAKT, k1.numerkontrakt,&#xA;           ROW_NUMBER() OVER (PARTITION BY mo.ID_MULTIKONTRAKT ORDER BY k1.idkontrakt) AS rn&#xA;    FROM multi_orders mo&#xA;    JOIN kontraktlista k1 ON k1.idkontrakt = mo.id_masterkontrakt&#xA;) mo_master_num ON mo_master_num.ID_MULTIKONTRAKT = k.idkontrakt&#xA;               AND mo_master_num.rn = 1&#xA;&#xA;-- ISPMP&#xA;LEFT JOIN KONTRAKTLISTA_SYSTEM_EXT kse ON kse.NUMERKONTRAKT = k.numerkontrakt&#xA;&#xA;-- iloscumow1&#xA;LEFT JOIN (&#xA;    SELECT id_kontraktlista, COUNT(*) AS cnt&#xA;    FROM REZ_LU_KONTRAKT&#xA;    GROUP BY id_kontraktlista&#xA;) luk1 ON luk1.id_kontraktlista = k.idkontrakt&#xA;&#xA;-- iloscumow2 (podzlecenia mastera)&#xA;LEFT JOIN (&#xA;    SELECT mo.id_multikontrakt, COUNT(*) AS cnt&#xA;    FROM multi_orders mo&#xA;    JOIN kontraktlista kmaster ON kmaster.idkontrakt = mo.id_masterkontrakt&#xA;    JOIN REZ_LU_KONTRAKT luk   ON luk.id_kontraktlista = kmaster.idkontrakt&#xA;    GROUP BY mo.id_multikontrakt&#xA;) luk2 ON luk2.id_multikontrakt = k.idkontrakt&#xA;&#xA;-- IsFZ (COUNT)&#xA;LEFT JOIN (&#xA;    SELECT fzkk.id_kk, COUNT(*) AS cnt&#xA;    FROM fakturazbiorcza_kk fzkk&#xA;    JOIN fakturazbiorcza fz ON fzkk.id_fz = fz.idfz&#xA;    GROUP BY fzkk.id_kk&#xA;) fz_agg ON fz_agg.id_kk = kk.idkk&#xA;&#xA;-- numerFZ + IdFZ (TOP 1 — jeden JOIN zamiast dwóch subquery)&#xA;LEFT JOIN (&#xA;    SELECT fzkk.id_kk, fz.numerfaktury, fz.idFZ,&#xA;           ROW_NUMBER() OVER (PARTITION BY fzkk.id_kk ORDER BY fz.idfz) AS rn&#xA;    FROM fakturazbiorcza_kk fzkk&#xA;    JOIN fakturazbiorcza fz ON fzkk.id_fz = fz.idfz&#xA;) fz_top ON fz_top.id_kk = kk.idkk AND fz_top.rn = 1&#xA;&#xA;-- numerZL (TOP 1)&#xA;LEFT JOIN (&#xA;    SELECT szc.ID_SUBORDER, sz.NUMERZAMOWIENIA,&#xA;           ROW_NUMBER() OVER (PARTITION BY szc.ID_SUBORDER ORDER BY sz.IDSZ) AS rn&#xA;    FROM sponsoring_zamowienie_channels szc&#xA;    JOIN sponsoring_zamowienie sz ON sz.IDSZ = szc.ID_SZ&#xA;) sz_top ON sz_top.ID_SUBORDER = k.IDKONTRAKT AND sz_top.rn = 1&#xA;&#xA;-- IS_WO_DIGITAL&#xA;LEFT JOIN MULTI_ORDERS_PARAMS mop ON mop.ID_KONTRAKT = k.IDKONTRAKT&#xA;OPTION (RECOMPILE)" StatementType="SELECT" QueryHash="0x7224121B137A5453" QueryPlanHash="0x41C8941321865A1C" RetrievedFromCache="false" StatementSqlHandle="0x0900E451F1790F332D627CDA8332D2B43E850000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="17" ParentObjectId="0" StatementParameterizationType="0" SecurityPolicyApplied="false" BatchModeOnRowStoreUsed="true">
          <StatementSetOptions ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" NUMERIC_ROUNDABORT="false" QUOTED_IDENTIFIER="true" />
