      <Statements>
        <StmtSimple StatementCompId="1" StatementEstRows="102802" StatementId="1" StatementOptmLevel="FULL" CardinalityEstimationModelVersion="150" StatementSubTreeCost="66.4131" StatementText="SELECT&#xA;    kk.IDKK,&#xA;    kk.ID_KONTRAKT,&#xA;&#xA;    spot_agg.BLOKDATA_MAX&#xA;&#xA;&#xA;FROM kontrakt_korekty kk&#xA;JOIN kontraktlista k   ON kk.id_kontrakt = k.idkontrakt&#xA;JOIN blokperiod bd     ON k.id_okres = bd.idblokperiod&#xA;                      AND bd.okresblokperiod = (2026*12+7)&#xA;&#xA;-- MAX(BLOKDATA) zamiast subquery z 4 tabelami&#xA;LEFT JOIN (&#xA;    SELECT s.id_kontrakt, MAX(dt.BLOKDATA) AS BLOKDATA_MAX&#xA;    FROM SPOTLISTA s&#xA;    JOIN BLOKLISTA   bl ON s.ID_BLOK          = bl.IDBLOK&#xA;    JOIN BLOKPROGRAM bp ON bp.IDBLOKPROGRAM   = bl.ID_BLOKPROGRAM&#xA;    JOIN DNIOTWARTE  dt ON dt.IDDNIOTWARTE         = bp.ID_DNIOTWARTE   &#xA;    GROUP BY s.id_kontrakt&#xA;) spot_agg ON spot_agg.id_kontrakt = k.idkontrakt" StatementType="SELECT" QueryHash="0x5C544805379C165B" QueryPlanHash="0x692070171454B92C" RetrievedFromCache="true" StatementSqlHandle="0x09001A505C2C515F2BC53E539E236FA52F140000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="17" ParentObjectId="0" StatementParameterizationType="0" SecurityPolicyApplied="false" BatchModeOnRowStoreUsed="true">
