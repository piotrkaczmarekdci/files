      <Statements>
        <StmtSimple StatementCompId="1" StatementEstRows="102903" StatementId="1" StatementOptmLevel="FULL" CardinalityEstimationModelVersion="150" StatementSubTreeCost="914.923" StatementText="SELECT&#xA;    kk.IDKK,&#xA;    kk.ID_KONTRAKT,&#xA;&#xA;    sz_top.NUMERZAMOWIENIA      AS numerZL,&#xA;&#xA;    mop.IS_WO_DIGITAL&#xA;&#xA;FROM kontrakt_korekty kk&#xA;JOIN kontraktlista k   ON kk.id_kontrakt = k.idkontrakt&#xA;JOIN blokperiod bd     ON k.id_okres = bd.idblokperiod&#xA;                      AND bd.okresblokperiod = (2026*12+7)&#xA;&#xA;&#xA;-- numerZL (TOP 1 › ROW_NUMBER)&#xA;--LEFT JOIN (&#xA;--    SELECT szc.ID_SUBORDER,&#xA;--           sz.NUMERZAMOWIENIA,&#xA;--           ROW_NUMBER() OVER (PARTITION BY szc.ID_SUBORDER ORDER BY sz.IDSZ) AS rn&#xA;--    FROM sponsoring_zamowienie_channels szc&#xA;--    JOIN sponsoring_zamowienie sz ON sz.IDSZ = szc.ID_SZ&#xA;--) sz_top ON sz_top.ID_SUBORDER = k.IDKONTRAKT&#xA;--        AND sz_top.rn = 1&#xA;OUTER APPLY (&#xA;    SELECT TOP 1&#xA;        sz.NUMERZAMOWIENIA&#xA;    FROM sponsoring_zamowienie_channels szc&#xA;    JOIN sponsoring_zamowienie          sz  ON sz.IDSZ = szc.ID_SZ&#xA;    WHERE szc.ID_SUBORDER = k.IDKONTRAKT&#xA;    ORDER BY sz.IDSZ&#xA;) sz_top&#xA; --IS_WO_DIGITAL&#xA;LEFT JOIN MULTI_ORDERS_PARAMS mop ON mop.ID_KONTRAKT = k.IDKONTRAKT" StatementType="SELECT" QueryHash="0x3D92BDDF1AD3B112" QueryPlanHash="0x27498467A3CC16A7" RetrievedFromCache="true" StatementSqlHandle="0x0900B5BA904480C2BFB8498029559F18CB6D0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="17" ParentObjectId="0" StatementParameterizationType="0" SecurityPolicyApplied="false">
