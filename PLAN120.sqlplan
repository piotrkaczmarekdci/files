<ShowPlanXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" Version="1.564" Build="16.0.4255.1" xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan">
  <BatchSequence>
    <Batch>
      <Statements>
        <StmtSimple StatementCompId="1" StatementEstRows="720.421" StatementId="1" StatementOptmLevel="FULL" CardinalityEstimationModelVersion="150" StatementSubTreeCost="404.604" StatementText="SELECT&#xD;&#xA; k.idkontrakt,&#xD;&#xA;ISNULL(mo.TotalProcGRP, 0)          AS SplitGRP,&#xD;&#xA;ISNULL(ppc.ISPREFERREDPOSITION, 0)  AS ISPREFERREDPOSITION,&#xD;&#xA;ISNULL(ppm.ISPREFERREDPOSITIONMULTI,0) AS ISPREFERREDPOSITIONMULTI,&#xD;&#xA;ISNULL(mk.MultiPakietBudget, 0)     AS MultiPakietBudget,&#xD;&#xA;ISNULL(mo.IlePodzlecenMIX, 0)       AS IlePodzlecenMIX,&#xD;&#xA;cast(0 as float) as MultiSponsWartosc, &#xD;&#xA;ISNULL(sk.KW, 0)                    AS KW,&#xD;&#xA;ISNULL(fbm.iloscspotownotopt, 0)    AS iloscspotownotopt,&#xD;&#xA;cast(0 as float) as SpotyMultiPakietBudget,&#xD;&#xA;ISNULL(rm.iloscspotow, 0)           AS iloscspotow, &#xD;&#xA;ISNULL(rm.PrognozaGRP, 0)           AS PrognozaGRP, &#xD;&#xA;ISNULL(rm.PrognozaGRPA1649, 0)      AS PrognozaGRPA1649,&#xD;&#xA;ISNULL(rm.PredGRPA1649, 0)          AS PredGRPA1649,&#xD;&#xA;ISNULL(rm.PredGRP, 0)               AS PredGRP&#xD;&#xA;--into #tblValues &#xD;&#xA;FROM dbo.KONTRAKTLISTA k&#xD;&#xA;INNER JOIN blokperiod bd ON bd.IDBLOKPERIOD = k.ID_OKRES&#xD;&#xA;OUTER APPLY (&#xD;&#xA;    SELECT SUM(mo.PROC_GRP) AS TotalProcGRP,&#xD;&#xA;           COUNT(*)         AS IlePodzlecenMIX&#xD;&#xA;    FROM dbo.MULTI_ORDERS mo&#xD;&#xA;    WHERE mo.ID_MASTERKONTRAKT = k.IDKONTRAKT&#xD;&#xA;) mo&#xD;&#xA;OUTER APPLY (&#xD;&#xA;    SELECT TOP (1) 1 AS ISPREFERREDPOSITION&#xD;&#xA;    FROM dbo.SPOTLISTA_POZYCJA sp&#xD;&#xA;    INNER JOIN SPOTLISTA s ON sp.ID_SPOT = s.IDSPOT&#xD;&#xA;    WHERE sp.ID_KONTRAKT = k.IDKONTRAKT&#xD;&#xA;) ppc&#xD;&#xA;OUTER APPLY (&#xD;&#xA;    SELECT COUNT(*) AS ISPREFERREDPOSITIONMULTI&#xD;&#xA;    FROM dbo.MULTI_ORDERS mo&#xD;&#xA;    INNER JOIN dbo.KONTRAKTLISTA k2 ON mo.ID_MULTIKONTRAKT = k2.IDKONTRAKT&#xD;&#xA;    INNER JOIN SPOTLISTA s2 ON k2.IDKONTRAKT = s2.ID_KONTRAKT&#xD;&#xA;    INNER JOIN dbo.SPOTLISTA_POZYCJA sp ON s2.IDSPOT = sp.ID_SPOT&#xD;&#xA;    WHERE mo.ID_MASTERKONTRAKT = k.IDKONTRAKT&#xD;&#xA;) ppm&#xD;&#xA;OUTER APPLY (&#xD;&#xA;    SELECT SUM(k12.BUDGETNETTO) AS MultiPakietBudget&#xD;&#xA;    FROM dbo.MULTI_ORDERS mo&#xD;&#xA;    INNER JOIN dbo.KONTRAKTLISTA k12 ON k12.IDKONTRAKT = mo.ID_MULTIKONTRAKT&#xD;&#xA;    INNER JOIN dbo.BLOKPERIOD bp12 ON bp12.IDBLOKPERIOD = k12.ID_OKRES&#xD;&#xA;    WHERE mo.ID_MASTERKONTRAKT = k.IDKONTRAKT&#xD;&#xA;) mk&#xD;&#xA;OUTER APPLY (&#xD;&#xA;    SELECT COUNT(*) AS KW&#xD;&#xA;    FROM dbo.KONTRAKT_SALESKOREKTY ks&#xD;&#xA;    WHERE ks.ID_KONTRAKT = k.IDKONTRAKT AND ks.ISKOREKTAWEWNETRZNA = 1&#xD;&#xA;) sk&#xD;&#xA;OUTER APPLY (&#xD;&#xA;    SELECT COUNT(*) AS iloscspotownotopt&#xD;&#xA;    FROM dbo.MULTI_ORDERS mo&#xD;&#xA;    INNER JOIN dbo.KONTRAKTLISTA k12 ON k12.IDKONTRAKT = mo.ID_MULTIKONTRAKT&#xD;&#xA;    INNER JOIN SPOTLISTA s12 ON s12.ID_KONTRAKT = k12.IDKONTRAKT&#xD;&#xA;    INNER JOIN dbo.SPOTLISTA_FIXINBREAK sfb ON s12.IDSPOT = sfb.ID_SPOT&#xD;&#xA;    WHERE mo.ID_MASTERKONTRAKT = k.IDKONTRAKT&#xD;&#xA;) fbm&#xD;&#xA;OUTER APPLY (&#xD;&#xA;    SELECT COUNT(*) AS iloscspotownotopt1&#xD;&#xA;    FROM SPOTLISTA s&#xD;&#xA;    INNER JOIN dbo.SPOTLISTA_FIXINBREAK sfb ON s.IDSPOT = sfb.ID_SPOT&#xD;&#xA;    WHERE s.ID_KONTRAKT = k.IDKONTRAKT&#xD;&#xA;) fbs&#xD;&#xA;OUTER APPLY (&#xD;&#xA;    SELECT SUM(s12.items)                 AS iloscspotow,&#xD;&#xA;           SUM(s12.GRPPROGNOZA)           AS PrognozaGRP,&#xD;&#xA;           SUM(s12.PROGNOZAGRPA1649MONO)  AS PrognozaGRPA1649,&#xD;&#xA;           SUM(s12.PredGRPA1649Mono)      AS PredGRPA1649,&#xD;&#xA;           SUM(s12.SYS_RTGPRED)           AS PredGRP,&#xD;&#xA;           SUM(s12.wartoscprzeliczonanetto) AS SpotyMultiPakietBudget1&#xD;&#xA;    FROM dbo.MULTI_ORDERS mo&#xD;&#xA;    INNER JOIN dbo.KONTRAKTLISTA k12 ON k12.IDKONTRAKT = mo.ID_MULTIKONTRAKT&#xD;&#xA;    INNER JOIN vw_ratings s12 ON s12.idkontrakt = k12.IDKONTRAKT&#xD;&#xA;    WHERE mo.ID_MASTERKONTRAKT = k.IDKONTRAKT&#xD;&#xA;) rm&#xD;&#xA;OUTER APPLY (&#xD;&#xA;    SELECT SUM(ks.BUDGETNETTO) AS MultiSponsWartoscc1&#xD;&#xA;    FROM dbo.KONTRAKT_SUBORDER ks&#xD;&#xA;    WHERE ks.ID_KONTRAKT = k.IDKONTRAKT&#xD;&#xA;) so&#xD;&#xA;OUTER APPLY (&#xD;&#xA;    SELECT spo.items                AS iloscspotow1,&#xD;&#xA;           spo.GRPPROGNOZA          AS PrognozaGRP1,&#xD;&#xA;           spo.PROGNOZAGRPA1649MONO AS PrognozaGRPA16491,&#xD;&#xA;           spo.PredGRPA1649Mono     AS PredGRPA16491,&#xD;&#xA;           spo.SYS_RTGPRED          AS PredGRP1,&#xD;&#xA;           spo.wartoscprzeliczonanetto  AS SpotyMultiPakietBudget&#xD;&#xA;    FROM vw_ratings spo&#xD;&#xA;    WHERE spo.idkontrakt = k.IDKONTRAKT&#xD;&#xA;) rs&#xD;&#xA;WHERE k.id_okres=47497" StatementType="SELECT" QueryHash="0xC790CF8EE68D5D05" QueryPlanHash="0x57C270CE6084C172" RetrievedFromCache="true" StatementSqlHandle="0x0900151E74CEEE748EF6E68C093DEF6458E50000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="13" ParentObjectId="0" StatementParameterizationType="0" SecurityPolicyApplied="false" BatchModeOnRowStoreUsed="true">
