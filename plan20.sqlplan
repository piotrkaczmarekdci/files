  <BatchSequence>
    <Batch>
      <Statements>
        <StmtSimple StatementCompId="1" StatementEstRows="1604860" StatementId="1" StatementOptmLevel="FULL" CardinalityEstimationModelVersion="150" StatementSubTreeCost="2849.3" StatementText="SELECT kk.IDKK, k.IDKONTRAKT,&#xD;&#xA;(select max(dt.BLOKDATA) from SPOTLISTA s, bloklista bl, blokprogram bp, dniotwarte dt where s.id_kontrakt=k.idkontrakt and s.ID_BLOK=bl.IDBLOK and bp.IDBLOKPROGRAM=bl.ID_BLOKPROGRAM and dt.IDDNIOTWARTE=bp.ID_DNIOTWARTE) as lastday,&#xD;&#xA;(select top 1 k1.NUMERKONTRAKT from MULTI_ORDERS mo, kontraktlista k1 where mo.ID_MULTIKONTRAKT=k.IDKONTRAKT and mo.ID_MASTERKONTRAKT=k1.IDKONTRAKT) as NumerMaster,&#xD;&#xA;(select count(*) from kontrakt_korekty kk1 where kk.idkk=kk1.IDKK_MASTER) as iloscpodkorekt,&#xD;&#xA;(select Count(*) from MULTI_ORDERS mo, kontraktlista k1 where mo.ID_MASTERKONTRAKT=k.IDKONTRAKT and mo.ID_MULTIKONTRAKT=k1.IDKONTRAKT) as iloscpodzlecen,&#xD;&#xA;(select count(*) from MULTI_ORDERS mo where mo.ID_MULTIKONTRAKT=k.idkontrakt) as ISSUBORDERMULTI,&#xD;&#xA;(select top 1 ISPMP from KONTRAKTLISTA_SYSTEM_EXT  where NUMERKONTRAKT = k.numerkontrakt) as ISPMP,&#xD;&#xA;(select COUNT(*) from fakturazbiorcza_kk fzkk, fakturazbiorcza fz where fzkk.id_kk=kk.idkk and fzkk.id_fz=fz.idfz) as IsFZ,&#xD;&#xA;(select top 1 fz.numerfaktury from fakturazbiorcza_kk fzkk, fakturazbiorcza fz where fzkk.id_kk=kk.idkk and fzkk.id_fz=fz.idfz) as numerFZ,&#xD;&#xA;(select top 1 fz.IDFZ from fakturazbiorcza_kk fzkk, fakturazbiorcza fz where fzkk.id_kk=kk.idkk and fzkk.id_fz=fz.idfz) as IDFZ,&#xD;&#xA;(select TOP 1 sz.NUMERZAMOWIENIA from sponsoring_zamowienie sz, sponsoring_zamowienie_channels szc where k.IDKONTRAKT=szc.ID_SUBORDER and szc.ID_SZ=sz.IDSZ) as numerZL,&#xD;&#xA;(SELECT mop.IS_WO_DIGITAL FROM MULTI_ORDERS_PARAMS mop WHERE mop.ID_KONTRAKT=k.IDKONTRAKT) AS IS_WO_DIGITAL&#xD;&#xA;FROM kontrakt_korekty kk, kontraktlista k, blokperiod bd&#xD;&#xA;WHERE kk.ID_KONTRAKT=k.IDKONTRAKT AND k.ID_OKRES=bd.IDBLOKPERIOD AND bd.OKRESBLOKPERIOD=2026*12+7" StatementType="SELECT" QueryHash="0xC38B66EB8AB5EEAD" QueryPlanHash="0x2063106EF3498F60" RetrievedFromCache="true" StatementSqlHandle="0x0900E105CD024A81EE7A8F0DE23A2182D2C90000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="17" ParentObjectId="0" StatementParameterizationType="0" SecurityPolicyApplied="false">
