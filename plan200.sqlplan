    <Batch>
      <Statements>
        <StmtSimple StatementCompId="4" StatementEstRows="108127" StatementId="4" StatementOptmLevel="FULL" CardinalityEstimationModelVersion="150" StatementSubTreeCost="84.0709" StatementText="SELECT&#xD;&#xA;    kk.IDKK,&#xD;&#xA;    kk.ID_KONTRAKT,&#xD;&#xA;    spot_agg.BLOKDATA_MAX,&#xD;&#xA;    kse.ISPMP,&#xD;&#xA;    ISNULL(luk1.cnt, 0)         AS iloscumow1,&#xD;&#xA;    ISNULL(luk2.cnt, 0)         AS iloscumow2,&#xD;&#xA;    ISNULL(fz_agg.cnt, 0)       AS IsFZ,&#xD;&#xA;    fz_top.numerfaktury         AS numerFZ,&#xD;&#xA;    fz_top.idFZ                 AS IdFZ,&#xD;&#xA;    sz_top.NUMERZAMOWIENIA      AS numerZL,&#xD;&#xA;    mop.IS_WO_DIGITAL,&#xD;&#xA;    ISNULL(vm.iloscsub,  0) AS IsMasterZlecenie,&#xD;&#xA;	ISNULL(vo.idkontrakt,  0) AS IsPodzlecenie,&#xD;&#xA;	vo.numerkontrakt AS MasterNumer&#xD;&#xA;	INTO #tblFaktDocs2&#xD;&#xA;FROM kontrakt_korekty kk&#xD;&#xA;JOIN #tblFaktOrder tb   ON kk.idkk = tb.idkk&#xD;&#xA;-- MAX(BLOKDATA) zamiast subquery z 4 tabelami&#xD;&#xA;LEFT JOIN (&#xD;&#xA;    SELECT s.id_kontrakt, MAX(dt.BLOKDATA) AS BLOKDATA_MAX&#xD;&#xA;    FROM SPOTLISTA s&#xD;&#xA;    JOIN BLOKLISTA   bl ON s.ID_BLOK          = bl.IDBLOK&#xD;&#xA;    JOIN BLOKPROGRAM bp ON bp.IDBLOKPROGRAM   = bl.ID_BLOKPROGRAM&#xD;&#xA;    JOIN DNIOTWARTE  dt ON dt.IDDNIOTWARTE         = bp.ID_DNIOTWARTE&#xD;&#xA;    GROUP BY s.id_kontrakt&#xD;&#xA;) spot_agg ON spot_agg.id_kontrakt = kk.id_kontrakt&#xD;&#xA;-- ISPMP&#xD;&#xA;LEFT JOIN KONTRAKTLISTA_SYSTEM_EXT kse ON kse.NUMERKONTRAKT = tb.numerkontrakt&#xD;&#xA;-- iloscumow1&#xD;&#xA;LEFT JOIN (&#xD;&#xA;    SELECT id_kontraktlista, COUNT(*) AS cnt&#xD;&#xA;    FROM REZ_LU_KONTRAKT&#xD;&#xA;    GROUP BY id_kontraktlista&#xD;&#xA;) luk1 ON luk1.id_kontraktlista = kk.id_kontrakt&#xD;&#xA;-- iloscumow2&#xD;&#xA;LEFT JOIN (&#xD;&#xA;    SELECT mo.id_multikontrakt, COUNT(*) AS cnt&#xD;&#xA;    FROM multi_orders mo&#xD;&#xA;    JOIN kontraktlista    kmaster ON kmaster.idkontrakt        = mo.id_masterkontrakt&#xD;&#xA;    JOIN REZ_LU_KONTRAKT  luk     ON luk.id_kontraktlista      = kmaster.idkontrakt&#xD;&#xA;    GROUP BY mo.id_multikontrakt&#xD;&#xA;) luk2 ON luk2.id_multikontrakt = kk.id_kontrakt&#xD;&#xA;-- IsFZ (COUNT)&#xD;&#xA;LEFT JOIN (&#xD;&#xA;    SELECT fzkk.id_kk, COUNT(*) AS cnt&#xD;&#xA;    FROM fakturazbiorcza_kk fzkk&#xD;&#xA;    JOIN fakturazbiorcza fz ON fzkk.id_fz = fz.idfz&#xD;&#xA;    GROUP BY fzkk.id_kk&#xD;&#xA;) fz_agg ON fz_agg.id_kk = kk.idkk&#xD;&#xA;-- numerFZ + IdFZ (jeden JOIN zamiast dwóch subquery)&#xD;&#xA;LEFT JOIN (&#xD;&#xA;    SELECT fzkk.id_kk,&#xD;&#xA;           fz.numerfaktury,&#xD;&#xA;           fz.idFZ,&#xD;&#xA;           ROW_NUMBER() OVER (PARTITION BY fzkk.id_kk ORDER BY fz.idfz) AS rn&#xD;&#xA;    FROM fakturazbiorcza_kk fzkk&#xD;&#xA;    JOIN fakturazbiorcza fz ON fzkk.id_fz = fz.idfz&#xD;&#xA;) fz_top ON fz_top.id_kk = kk.idkk&#xD;&#xA;        AND fz_top.rn = 1&#xD;&#xA;-- numerZL (TOP 1 › ROW_NUMBER)&#xD;&#xA;LEFT JOIN (&#xD;&#xA;    SELECT szc.ID_SUBORDER,&#xD;&#xA;           sz.NUMERZAMOWIENIA,&#xD;&#xA;           ROW_NUMBER() OVER (PARTITION BY szc.ID_SUBORDER ORDER BY sz.IDSZ) AS rn&#xD;&#xA;    FROM sponsoring_zamowienie_channels szc&#xD;&#xA;    JOIN sponsoring_zamowienie sz ON sz.IDSZ = szc.ID_SZ&#xD;&#xA;) sz_top ON sz_top.ID_SUBORDER = kk.ID_KONTRAKT&#xD;&#xA;        AND sz_top.rn = 1&#xD;&#xA;-- IS_WO_DIGITAL&#xD;&#xA;LEFT JOIN MULTI_ORDERS_PARAMS mop ON mop.ID_KONTRAKT = kk.ID_KONTRAKT&#xD;&#xA;LEFT JOIN vw_multiorder vm ON kk.ID_KONTRAKT = vm.idkontrakt&#xD;&#xA;left join vw_masterorder vo ON kk.ID_KONTRAKT=vo.id_multikontrakt" StatementType="SELECT INTO" QueryHash="0x61CC14861B5AC18B" QueryPlanHash="0xBCAC11C68632FBD8" RetrievedFromCache="true" StatementSqlHandle="0x090041594A959A990A65113687692A274E170000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="13" ParentObjectId="0" BatchSqlHandle="0x02000000DE3CED2EC3C23FE0149A0B13DB205D3CDBFE2C390000000000000000000000000000000000000000" StatementParameterizationType="0" SecurityPolicyApplied="false" BatchModeOnRowStoreUsed="true">
