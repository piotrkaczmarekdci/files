      <Statements>
        <StmtSimple StatementCompId="1" StatementEstRows="102818" StatementId="1" StatementOptmLevel="FULL" CardinalityEstimationModelVersion="150" StatementSubTreeCost="73.1238" StatementText="SELECT&#xD;&#xA;    kk.IDKK,&#xD;&#xA;    kk.ID_KONTRAKT,&#xD;&#xA;&#xD;&#xA;    spot_agg.BLOKDATA_MAX&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;FROM kontrakt_korekty kk&#xD;&#xA;JOIN kontraktlista k   ON kk.id_kontrakt = k.idkontrakt&#xD;&#xA;JOIN blokperiod bd     ON k.id_okres = bd.idblokperiod&#xD;&#xA;                      AND bd.okresblokperiod = (2026*12+7)&#xD;&#xA;&#xD;&#xA;-- MAX(BLOKDATA) zamiast subquery z 4 tabelami&#xD;&#xA;LEFT JOIN (&#xD;&#xA;    SELECT s.id_kontrakt, MAX(dt.BLOKDATA) AS BLOKDATA_MAX&#xD;&#xA;    FROM SPOTLISTA s&#xD;&#xA;    JOIN BLOKLISTA   bl ON s.ID_BLOK          = bl.IDBLOK&#xD;&#xA;    JOIN BLOKPROGRAM bp ON bp.IDBLOKPROGRAM   = bl.ID_BLOKPROGRAM&#xD;&#xA;    JOIN DNIOTWARTE  dt ON dt.IDDNIOTWARTE         = bp.ID_DNIOTWARTE   &#xD;&#xA;    GROUP BY s.id_kontrakt&#xD;&#xA;) spot_agg ON spot_agg.id_kontrakt = k.idkontrakt" StatementType="SELECT" QueryHash="0x5C544805379C165B" QueryPlanHash="0x692070171454B92C" RetrievedFromCache="true" StatementSqlHandle="0x090031115BCFE19CE1C4E3B1D7044A38D2770000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="13" ParentObjectId="0" StatementParameterizationType="0" SecurityPolicyApplied="false" BatchModeOnRowStoreUsed="true">
