      <Statements>
        <StmtSimple StatementCompId="1" StatementEstRows="2244.72" StatementId="1" StatementOptmLevel="FULL" CardinalityEstimationModelVersion="150" StatementSubTreeCost="42.822" StatementText="SELECT s.id_kontrakt, MAX(dt.BLOKDATA) AS BLOKDATA_MAX&#xD;&#xA;	into #tblTemp&#xD;&#xA;    FROM SPOTLISTA s&#xD;&#xA;    JOIN BLOKLISTA   bl ON s.ID_BLOK          = bl.IDBLOK&#xD;&#xA;    JOIN BLOKPROGRAM bp ON bp.IDBLOKPROGRAM   = bl.ID_BLOKPROGRAM&#xD;&#xA;    JOIN DNIOTWARTE  dt ON dt.IDDNIOTWARTE         = bp.ID_DNIOTWARTE   &#xD;&#xA;    JOIN kontraktlista k2  ON k2.idkontrakt = s.id_kontrakt&#xD;&#xA;    JOIN blokperiod bd2    ON k2.id_okres   = bd2.idblokperiod&#xD;&#xA;                          AND bd2.okresblokperiod = (2026*12+7)&#xD;&#xA;    GROUP BY s.id_kontrakt" StatementType="SELECT INTO" QueryHash="0xFEB47E8AF27256F0" QueryPlanHash="0xDB343C91A145BDB9" RetrievedFromCache="true" StatementSqlHandle="0x09005DD4D3EF703C88329E578158BFDE72240000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="13" ParentObjectId="0" StatementParameterizationType="0" SecurityPolicyApplied="false" BatchModeOnRowStoreUsed="true">
