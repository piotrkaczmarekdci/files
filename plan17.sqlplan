<?xml version="1.0" encoding="utf-16"?>
<ShowPlanXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" Version="1.539" Build="15.0.4395.2" xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan">
  <BatchSequence>
    <Batch>
      <Statements>
        <StmtSimple StatementCompId="4" StatementEstRows="326164" StatementId="1" StatementOptmLevel="FULL" CardinalityEstimationModelVersion="150" StatementSubTreeCost="1121.62" StatementText="SELECT &#xA;    K.IDKONTRAKT,&#xA;    -- Agregaty z KONTRAKT_KOREKTY (jeden przebieg)&#xA;    KK.IloscKorekt,&#xA;    KK.Ilosc,&#xA;    KK.IloscKK,&#xA;    KK_Last.NettoZDokumentow,&#xA;    KK_Last.nzd_NBUDGETNETTO,&#xA;    KK.NettoZKorektBNG,&#xA;    KK.DataZmiany,&#xA;    -- MULTI_ORDERS - podzlecenie&#xA;    MO_Sub.IsPodzlecenie,&#xA;    -- Master info&#xA;    KMaster.NUMERKONTRAKT AS MasterOrder,&#xA;    KMaster.ZAFAKTUROWANY AS MasterZAFAKTUROWANY,&#xA;    -- Suborders&#xA;    MO_Master.IloscSub,&#xA;    MO_Master.IloscSubFakt,&#xA;    -- Sponsoring FZ&#xA;    FZ.IsFZ,&#xA;    -- Numer FZ&#xA;    FZ_Num.NumerFZ&#xA;FROM KONTRAKTLISTA K&#xA;JOIN BLOKPERIOD BD ON K.ID_OKRES = BD.IDBLOKPERIOD&#xA;-- Agregaty z KONTRAKT_KOREKTY - jeden skan zamiast 6&#xA;LEFT JOIN (&#xA;    SELECT &#xA;        ID_KONTRAKT,&#xA;        COUNT(*) AS IloscKorekt,&#xA;        COUNT(CASE WHEN ISKOREKTA = 1 THEN 1 END) AS Ilosc,&#xA;        COUNT(*) AS IloscKK,&#xA;        MAX(DATAZMIANY) AS DataZmiany,&#xA;        SUM(WARTOSCDOKUMENTU) AS NettoZKorektBNG,&#xA;        -- TOP 1 ORDER BY IDKK DESC via MAX&#xA;        NULL AS NettoZDokumentow,&#xA;        NULL AS nzd_NBUDGETNETTO&#xA;    FROM KONTRAKT_KOREKTY&#xA;    GROUP BY ID_KONTRAKT&#xA;) KK ON KK.ID_KONTRAKT = K.IDKONTRAKT&#xA;-- TOP 1 z KONTRAKT_KOREKTY (ostatnia korekta)&#xA;OUTER APPLY (&#xA;    SELECT TOP 1 kk2.SUNNETTO AS NettoZDokumentow, kk2.NBUDGETNETTO AS nzd_NBUDGETNETTO&#xA;    FROM KONTRAKT_KOREKTY kk2&#xA;    WHERE kk2.ID_KONTRAKT = K.IDKONTRAKT&#xA;    ORDER BY kk2.IDKK DESC&#xA;) KK_Last&#xA;-- Czy jest podzleceniem&#xA;LEFT JOIN (&#xA;    SELECT ID_MULTIKONTRAKT, COUNT(*) AS IsPodzlecenie, ID_MASTERKONTRAKT&#xA;    FROM MULTI_ORDERS&#xA;    GROUP BY ID_MULTIKONTRAKT, ID_MASTERKONTRAKT&#xA;) MO_Sub ON MO_Sub.ID_MULTIKONTRAKT = K.IDKONTRAKT&#xA;-- Master info&#xA;LEFT JOIN KONTRAKTLISTA KMaster ON KMaster.IDKONTRAKT = MO_Sub.ID_MASTERKONTRAKT&#xA;-- Suborders count&#xA;LEFT JOIN (&#xA;    SELECT &#xA;        MO.ID_MASTERKONTRAKT,&#xA;        COUNT(*) AS IloscSub,&#xA;        SUM(CASE WHEN KSub.ZAFAKTUROWANY = 1 THEN 1 ELSE 0 END) AS IloscSubFakt&#xA;    FROM MULTI_ORDERS MO&#xA;    JOIN KONTRAKTLISTA KSub ON MO.ID_MULTIKONTRAKT = KSub.IDKONTRAKT&#xA;    GROUP BY MO.ID_MASTERKONTRAKT&#xA;) MO_Master ON MO_Master.ID_MASTERKONTRAKT = K.IDKONTRAKT&#xA;-- IsFZ&#xA;LEFT JOIN (&#xA;    SELECT SZC.ID_SUBORDER, COUNT(*) AS IsFZ&#xA;    FROM SPONSORING_ZAMOWIENIE SZ&#xA;    JOIN SPONSORING_ZAMOWIENIE_CHANNELS SZC ON SZC.ID_SZ = SZ.IDSZ&#xA;    JOIN SA_PAKIETY PY ON SZ.ID_PAKIET = PY.IDPAKIET&#xA;    WHERE PY.ISFAKTURAZBIORCZA = 1&#xA;    GROUP BY SZC.ID_SUBORDER&#xA;) FZ ON FZ.ID_SUBORDER = K.IDKONTRAKT&#xA;-- Numer FZ&#xA;OUTER APPLY (&#xA;    SELECT TOP 1 SZ.NUMERZAMOWIENIA AS NumerFZ&#xA;    FROM SPONSORING_ZAMOWIENIE SZ&#xA;    JOIN SPONSORING_ZAMOWIENIE_CHANNELS SZC ON SZC.ID_SZ = SZ.IDSZ&#xA;    WHERE SZC.ID_SUBORDER = K.IDKONTRAKT&#xA;) FZ_Num&#xA;WHERE BD.OKRESBLOKPERIOD = @OkresBlokperiod&#xA;OPTION (RECOMPILE)" StatementType="SELECT" QueryHash="0xA9D52C8E6606E57C" QueryPlanHash="0x794B8B70CAD0F9AE" RetrievedFromCache="false" StatementSqlHandle="0x09007114831D31F66EC80C93C3322F4B590B0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="17" ParentObjectId="0" StatementParameterizationType="0" SecurityPolicyApplied="false" BatchModeOnRowStoreUsed="true">
          <StatementSetOptions ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" NUMERIC_ROUNDABORT="false" QUOTED_IDENTIFIER="true" />
