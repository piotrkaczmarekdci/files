<?xml version="1.0" encoding="utf-16"?>
<ShowPlanXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" Version="1.539" Build="15.0.4395.2" xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan">
  <BatchSequence>
    <Batch>
      <Statements>
        <StmtSimple StatementCompId="1" StatementEstRows="161406" StatementId="1" StatementOptmLevel="FULL" CardinalityEstimationModelVersion="150" StatementSubTreeCost="31913.4" StatementText="SELECT &#xA;    kk.IDKK,&#xA;    k.IDKONTRAKT,&#xA;    dt_max.MaxBLOKDATA,&#xA;    k1_master.NUMERKONTRAKT          AS NumerMaster,&#xA;    ISNULL(podkorekty.cnt, 0)        AS iloscpodkorekt,&#xA;    ISNULL(podzlecenia.cnt, 0)       AS iloscpodzlecen,&#xA;    ISNULL(submulti.cnt, 0)          AS ISSUBORDERMULTI,&#xA;    kse.ISPMP,&#xA;    ISNULL(fz_agg.cnt, 0)            AS IsFZ,&#xA;    fz_agg.numerfaktury              AS numerFZ,&#xA;    fz_agg.IDFZ                      AS IDFZ,&#xA;    sz_top.NUMERZAMOWIENIA           AS numerZL,&#xA;    mop.IS_WO_DIGITAL&#xA;FROM kontrakt_korekty kk&#xA;JOIN kontraktlista k        ON kk.ID_KONTRAKT = k.IDKONTRAKT&#xA;JOIN blokperiod bd          ON k.ID_OKRES = bd.IDBLOKPERIOD&#xA;                           AND bd.OKRESBLOKPERIOD = 2026 * 12 + 7&#xA;&#xA;-- 1) MAX(BLOKDATA) – zamiana skorelowanego podzapytania na APPLY&#xA;OUTER APPLY (&#xA;    SELECT MAX(dt.BLOKDATA) AS MaxBLOKDATA&#xA;    FROM SPOTLISTA s&#xA;    JOIN BLOKLISTA bl        ON s.ID_BLOK = bl.IDBLOK&#xA;    JOIN BLOKPROGRAM bp      ON bp.IDBLOKPROGRAM = bl.ID_BLOKPROGRAM&#xA;    JOIN DNIOTWARTE dt       ON dt.IDDNIOTWARTE = bp.ID_DNIOTWARTE  -- dopasuj FK&#xA;    WHERE s.ID_KONTRAKT = k.IDKONTRAKT&#xA;) dt_max&#xA;&#xA;-- 2) NumerMaster – TOP 1 z MULTI_ORDERS&#xA;OUTER APPLY (&#xA;    SELECT TOP 1 k1.NUMERKONTRAKT&#xA;    FROM MULTI_ORDERS mo&#xA;    JOIN kontraktlista k1 ON mo.ID_MASTERKONTRAKT = k1.IDKONTRAKT&#xA;    WHERE mo.ID_MULTIKONTRAKT = k.IDKONTRAKT&#xA;) k1_master&#xA;&#xA;-- 3) iloscpodkorekt&#xA;LEFT JOIN (&#xA;    SELECT IDKK_MASTER, COUNT(*) AS cnt&#xA;    FROM kontrakt_korekty&#xA;    GROUP BY IDKK_MASTER&#xA;) podkorekty ON podkorekty.IDKK_MASTER = kk.IDKK&#xA;&#xA;-- 4) iloscpodzlecen  +  5) ISSUBORDERMULTI  – MULTI_ORDERS czytana RAZ&#xA;LEFT JOIN (&#xA;    SELECT &#xA;        ID_MASTERKONTRAKT,&#xA;        ID_MULTIKONTRAKT,&#xA;        COUNT(*) OVER (PARTITION BY ID_MASTERKONTRAKT) AS cnt_master,&#xA;        COUNT(*) OVER (PARTITION BY ID_MULTIKONTRAKT)  AS cnt_multi&#xA;    FROM MULTI_ORDERS&#xA;) mo_agg ON 1=0  -- placeholder, patrz ni¿ej – lepiej dwa osobne LEFT JOIN:&#xA;&#xA;-- Wersja prostsza i bezpieczniejsza:&#xA;-- 4) iloscpodzlecen&#xA;LEFT JOIN (&#xA;    SELECT ID_MASTERKONTRAKT, COUNT(*) AS cnt&#xA;    FROM MULTI_ORDERS mo&#xA;    JOIN kontraktlista k1 ON mo.ID_MULTIKONTRAKT = k1.IDKONTRAKT&#xA;    GROUP BY ID_MASTERKONTRAKT&#xA;) podzlecenia ON podzlecenia.ID_MASTERKONTRAKT = k.IDKONTRAKT&#xA;&#xA;-- 5) ISSUBORDERMULTI&#xA;LEFT JOIN (&#xA;    SELECT ID_MULTIKONTRAKT, COUNT(*) AS cnt&#xA;    FROM MULTI_ORDERS&#xA;    GROUP BY ID_MULTIKONTRAKT&#xA;) submulti ON submulti.ID_MULTIKONTRAKT = k.IDKONTRAKT&#xA;&#xA;-- 6) ISPMP&#xA;OUTER APPLY (&#xA;    SELECT TOP 1 ISPMP&#xA;    FROM KONTRAKTLISTA_SYSTEM_EXT&#xA;    WHERE NUMERKONTRAKT = k.NUMERKONTRAKT&#xA;) kse&#xA;&#xA;-- 7) IsFZ + numerFZ + IDFZ  – JEDNO czytanie zamiast trzech&#xA;OUTER APPLY (&#xA;    SELECT TOP 1&#xA;        fz.IDFZ,&#xA;        fz.NUMERFAKTURY   AS numerfaktury,&#xA;        COUNT(*) OVER ()  AS cnt&#xA;    FROM fakturazbiorcza_kk fzkk&#xA;    JOIN fakturazbiorcza fz ON fzkk.ID_FZ = fz.IDFZ&#xA;    WHERE fzkk.ID_KK = kk.IDKK&#xA;) fz_agg&#xA;&#xA;-- 8) numerZL&#xA;OUTER APPLY (&#xA;    SELECT TOP 1 sz.NUMERZAMOWIENIA&#xA;    FROM sponsoring_zamowienie_channels szc&#xA;    JOIN sponsoring_zamowienie sz ON szc.ID_SZ = sz.IDSZ&#xA;    WHERE szc.ID_SUBORDER = k.IDKONTRAKT&#xA;) sz_top&#xA;&#xA;-- 9) IS_WO_DIGITAL&#xA;LEFT JOIN MULTI_ORDERS_PARAMS mop ON mop.ID_KONTRAKT = k.IDKONTRAKT" StatementType="SELECT" QueryHash="0x7745588F1C2A05FD" QueryPlanHash="0xC53F0E616574FBC9" RetrievedFromCache="true" StatementSqlHandle="0x0900CB3FF6230F8691106A470572113823460000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="17" ParentObjectId="0" StatementParameterizationType="0" SecurityPolicyApplied="false" BatchModeOnRowStoreUsed="true">
          <StatementSetOptions ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" ARITHABORT="true" CONCAT_NULL_YIELDS_NULL="true" NUMERIC_ROUNDABORT="false" QUOTED_IDENTIFIER="true" />
